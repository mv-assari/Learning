@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="card" id="ChatBox">
    <div class="card-header">
        <b>پشتیبانی آنلاین</b>
    </div>
    <div id="MessagePanel">
        <ul id="Message"></ul>
        <div id="SendNewMessage">
            <form id="NewMessageFrom" class="row">
                <input id="MessageInput" class="form-control col-md-8 col-sm-8" placeholder="پیام خود را وارد کنید ..." />
                <button class="btn btn-success col-md-4 col-md-4">ارسال</button>
            </form>
        </div>
    </div>
</div>
