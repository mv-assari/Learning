@model IEnumerable<RunIdentity.Areas.Admin.Models.Dto.UserListDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>لیست کاربران</h1>

<p>
    <a action="admin/user/Create" class="btn btn-primary">ایجاد کاربر جدید</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.LastName)</th>
            <th>@Html.DisplayNameFor(model => model.UserName)</th>
            <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
            <th>@Html.DisplayNameFor(model => model.EmailConfirmed)</th>
            <th>@Html.DisplayNameFor(model => model.AccessFailedCount)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.EmailConfirmed)</td>
                <td>@Html.DisplayFor(modelItem => item.AccessFailedCount)</td>
            </tr>
        }
    </tbody>
</table>