@model IEnumerable<RunIdentity.Areas.Admin.Models.Dto.Role.RoleListDto>

@{
    ViewData["Title"] = "مدیریت نقش‌ها";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>مدیریت نقش‌ها</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">ایجاد نقش جدید</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>
                    <a asp-action="Edit" asp-controller="Role" asp-area="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-warning">ویرایش</a>
                    <a asp-action="Details" asp-controller="Role" asp-area="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-info">جزئیات</a>
                    <a asp-action="UserInRole" asp-controller="Role" asp-area="Admin" asp-route-name="@item.Name" class="btn btn-sm btn-info">کاربران این نقش</a>
                    <a asp-action="Delete" asp-controller="Role" asp-area="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>