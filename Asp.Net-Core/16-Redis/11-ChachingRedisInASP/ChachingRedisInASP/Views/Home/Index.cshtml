@using ChachingRedisInASP.Models.Dto;
@model HomePageDto;
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="text-center">
    <h3 class="display-4" style="color:#0094ff">@ViewBag.From</h3>
</div>

<div class="row">

    @* ===== جدول بهترین محصولات ===== *@
    <div class="col-lg-6 mb-4">
        <h3 class="mb-3">بهترین محصولات</h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px">#</th>
                        <th>شناسه</th>
                        <th>نام محصول</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.BestProducts?.Products != null && Model.BestProducts.Products.Any())
                    {
                        var i = 1;
                        foreach (var product in Model.BestProducts.Products)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@product.Id</td>
                                <td>@product.Name</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">محصولی برای نمایش وجود ندارد</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ===== جدول جدیدترین محصولات ===== *@
    <div class="col-lg-6 mb-4">
        <h3 class="mb-3">جدیدترین محصولات</h3>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px">#</th>
                        <th>شناسه</th>
                        <th>نام محصول</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.LastProducts?.Products != null && Model.LastProducts.Products.Any())
                    {
                        var j = 1;
                        foreach (var product in Model.LastProducts.Products)
                        {
                            <tr>
                                <td>@(j++)</td>
                                <td>@product.Id</td>
                                <td>@product.Name</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">محصولی برای نمایش وجود ندارد</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
