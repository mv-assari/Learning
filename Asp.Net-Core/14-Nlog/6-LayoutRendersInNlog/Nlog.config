<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd">

	<targets async="true"> برای سرعت بیشتر از قابلیت همزمانی استفاده میکنیم
		<!--<target name="logfile" xsi:type="File" fileName="${basedir}/logs/file${shordate}.txt" />--> برای تغییر مسیر فایل و نام فایل روزانه
		<variable name="username" value="MVA"></variable>
		
		برای اطاعات بیشتر و دیدن امکانات بیشتر برای موارد زیر به سایت
		nlog.project.org
		مراجعه کنید
		
		<target name="logfile" xsi:type="File" 
				fileName="${basedir}/logs/file{####}.txt" 
				maxArchiveFiles="10" 
				archiveAboveSize="10240" 
				layout="${message} ${callsite} ${callsite-linenumber} ${callsite-filename} ${level} ${longdate}
				${newline}
				${var:username}
				${newline}
				${date}
				${longdate}
				${shortdate}
				${ticks}
				${time}
				${newline}
				${message:uppercase=true}
				${message:lowercase=true}
				"
				/>
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="logfile" />
	</rules>
</nlog>